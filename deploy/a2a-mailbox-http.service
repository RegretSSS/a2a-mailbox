[Unit]
Description=a2a-mailbox MCP http gateway
After=network.target a2a-hub.service

[Service]
ExecStart=/usr/bin/python3 %h/workspace/a2a-mailbox/mcp/http_gateway.py
WorkingDirectory=%h/workspace/a2a-mailbox
Environment=A2A_MAILBOX_ROOT=%h/.agents-mailbox
Environment=A2A_MCP_HTTP_BIND=127.0.0.1
Environment=A2A_MCP_HTTP_PORT=8765
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
